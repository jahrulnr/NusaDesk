<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Capability-bridge dialogs (dialog.show / termux-dialog). The host is
        CapabilityForegroundActivity, declared Theme.Translucent.NoTitleBar so
        the platform resolves plain AlertDialogs against the pre-Material look.
        The bridge instead shows a plain android.app.Dialog on this theme with
        the app's own shell (nusadesk_dialog_shell.xml): a rounded elevated
        surface, token colors, and the app's filled/outline button language.
        The values-notnight twin flips only the platform parent to the Light
        dialog so picker internals and inverse text colors follow the theme.
    -->
    <style name="NusaDeskDialogTheme" parent="android:style/Theme.Material.Dialog">
        <!-- The shell layout draws the rounded surface; the window itself is transparent. -->
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:colorControlActivated">@color/primary</item>
        <item name="android:colorControlNormal">@color/ink_muted</item>
        <item name="android:colorControlHighlight">@color/primary_tint</item>
        <item name="android:colorBackground">@color/surface_elevated</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/ink_secondary</item>
        <item name="android:textColorHint">@color/ink_muted</item>
        <item name="android:windowSoftInputMode">adjustResize|stateHidden</item>
    </style>

    <style name="Widget.LinuxWrapper.DialogTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">@dimen/nusadesk_dialog_padding</item>
        <item name="android:paddingEnd">@dimen/nusadesk_dialog_padding</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">@dimen/nusadesk_dialog_title_size</item>
        <item name="android:textStyle">bold</item>
        <item name="android:maxLines">4</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="Widget.LinuxWrapper.DialogMessage">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:lineSpacingExtra">4dp</item>
        <item name="android:textColor">@color/ink_secondary</item>
        <item name="android:textSize">@dimen/nusadesk_dialog_message_size</item>
    </style>

    <style name="Widget.LinuxWrapper.DialogInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/nusadesk_dialog_input</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textColorHint">@color/ink_muted</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Widget.LinuxWrapper.DialogButtonPrimary">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">88dp</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:background">@drawable/nusadesk_dialog_button_primary</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/button_primary_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.LinuxWrapper.DialogButtonNeutral">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">88dp</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:background">@drawable/nusadesk_dialog_button_neutral</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- One checkbox or radio row in a choice list. The platform compound
         drawable already encodes state as a shape (box outline vs check, ring
         vs dot), so selection is never color-only. -->
    <style name="Widget.LinuxWrapper.DialogChoice">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- One tappable row in the sheet list; the background drawable supplies
         the pressed and focused state so taps are visible. -->
    <style name="Widget.LinuxWrapper.DialogSheetItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/nusadesk_dialog_item_gap</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:background">@drawable/nusadesk_dialog_item</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Widget.LinuxWrapper.DialogCounterValue">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">@dimen/nusadesk_dialog_counter_text_size</item>
        <item name="android:textStyle">bold</item>
    </style>

    <dimen name="nusadesk_dialog_corner">18dp</dimen>
    <dimen name="nusadesk_dialog_button_corner">12dp</dimen>
    <dimen name="nusadesk_dialog_input_corner">10dp</dimen>
    <dimen name="nusadesk_dialog_padding">20dp</dimen>
    <dimen name="nusadesk_dialog_screen_margin">24dp</dimen>
    <dimen name="nusadesk_dialog_max_width">480dp</dimen>
    <dimen name="nusadesk_dialog_title_size">19sp</dimen>
    <dimen name="nusadesk_dialog_message_size">16sp</dimen>
    <dimen name="nusadesk_dialog_counter_text_size">32sp</dimen>
    <dimen name="nusadesk_dialog_counter_button_width">64dp</dimen>
    <dimen name="nusadesk_dialog_item_gap">2dp</dimen>
    <dimen name="nusadesk_dialog_button_gap">8dp</dimen>

    <!-- Button labels stay Java literals (they mirror the upstream
         termux-dialog wording); these strings exist for accessibility and
         for the spots lint requires a resource. The input hint is only the
         fallback shown when the guest sends no hint of its own. -->
    <string name="nusadesk_dialog_input_hint">Enter text</string>
    <string name="nusadesk_dialog_cancel">Cancel</string>
    <string name="nusadesk_dialog_counter_decrease">Decrease</string>
    <string name="nusadesk_dialog_counter_increase">Increase</string>
    <string name="nusadesk_dialog_counter_minus_sign">−</string>
    <string name="nusadesk_dialog_counter_plus_sign">+</string>
</resources>
