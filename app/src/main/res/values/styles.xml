<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:navigationBarDividerColor">@color/border</item>
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:colorBackground">@color/surface_elevated</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:alertDialogTheme">@style/AppDialogTheme</item>
    </style>

    <style name="AppDialogTheme" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:colorBackground">@color/surface_elevated</item>
        <item name="android:windowBackground">@drawable/dialog_surface</item>
    </style>

    <!-- Reusable presentation widget styles. Colors resolve per night/notnight. -->
    <style name="Widget.LinuxWrapper" parent="android:Widget" />

    <!-- One launcher tile's children. The tile itself is created in code so its
         grid span can follow the available width. -->
    <style name="Widget.LinuxWrapper.AppTileIcon">
        <item name="android:layout_width">@dimen/tile_icon_size</item>
        <item name="android:layout_height">@dimen/tile_icon_size</item>
        <item name="android:layout_gravity">center_horizontal</item>
        <item name="android:background">@drawable/tile_icon_surface</item>
        <item name="android:gravity">center</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <style name="Widget.LinuxWrapper.AppTileGlyph">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">@dimen/tile_glyph_size</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <style name="Widget.LinuxWrapper.AppTileLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:textSize">@dimen/tile_label_size</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:maxLines">2</item>
        <!-- Every tile reserves two label lines so a one-word app name does not
             make its tile shorter than its neighbours at any font scale. -->
        <item name="android:minLines">2</item>
        <item name="android:ellipsize">end</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <style name="Widget.LinuxWrapper.AppTileStatus">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/ink_muted</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <!-- Add / edit web app form fields. A label, an input, and one error line
         per field, so a rejected value is always attached to the field that
         caused it instead of only being announced at the bottom. -->
    <style name="Widget.LinuxWrapper.FieldLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.LinuxWrapper.FieldInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:background">@drawable/search_field_surface</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:paddingStart">@dimen/search_field_padding</item>
        <item name="android:paddingEnd">@dimen/search_field_padding</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textColorHint">@color/ink_muted</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Widget.LinuxWrapper.FieldError">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:lineSpacingExtra">2dp</item>
        <item name="android:textColor">@color/danger</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Widget.LinuxWrapper.FieldButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/button_height</item>
        <item name="android:background">@drawable/button_secondary</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Terminal accessory keys. The row is built in code so it can wrap to the -->
    <!-- available width; each key is inflated from widget_terminal_key. Key caps -->
    <!-- grow with the system font scale and shrink back to fit their key instead -->
    <!-- of wrapping mid-word on a narrow row. -->
    <style name="Widget.LinuxWrapper.TerminalKey">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">@dimen/terminal_key_height</item>
        <item name="android:background">@drawable/terminal_key_surface</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">9sp</item>
        <item name="android:autoSizeMaxTextSize">@dimen/terminal_key_text_size</item>
        <item name="android:autoSizeStepGranularity">1sp</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:maxLines">1</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/terminal_key_label</item>
        <item name="android:textSize">@dimen/terminal_key_text_size</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minWidth">@dimen/touch_target</item>
        <item name="android:minHeight">@dimen/terminal_key_height</item>
        <item name="android:paddingStart">@dimen/terminal_key_padding</item>
        <item name="android:paddingEnd">@dimen/terminal_key_padding</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- Section eyebrow label used across the launcher and app surfaces. -->
    <style name="Widget.LinuxWrapper.Eyebrow">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
