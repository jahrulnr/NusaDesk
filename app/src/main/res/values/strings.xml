    <!-- Linux system screen (install state, session details, contract) -->
    <string name="system_eyebrow">LINUX SYSTEM</string>
    <string name="system_title">Linux system</string>
    <string name="system_body">A verified, curated Ubuntu Base rootfs stored in app-private storage. The Android host owns the session lifecycle, starts it from an app launch, and keeps its state honest.</string>
    <string name="system_state_label">System state</string>
