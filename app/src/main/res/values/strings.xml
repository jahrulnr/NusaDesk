    <!-- The count is deliberately not a quantity string. A quantity string is
         resolved through the device locale's CLDR plural category, and locales
         with no plural marking (Indonesian, Chinese, Japanese, Korean) have
         only the "other" category, so the platform renders "1 apps" on an id-ID
         device. The launcher ships one default copy, so the count picks the
         form itself; see LauncherHeaderText. PluralsCandidate is the heuristic
         this deliberately contradicts. -->
    <string name="apps_count_singular" tools:ignore="PluralsCandidate">%1$d app</string>
    <string name="apps_count_plural" tools:ignore="PluralsCandidate">%1$d apps</string>

