    <string name="system_detail_app">Runtime profile</string>
    <string name="system_detail_version">Version</string>
    <string name="system_how_title">How NusaDesk works</string>
    <string name="system_how_body">Android host → verified system → Android-owned session → loopback endpoint → app surface. Linux starts when you open the app and keeps running in the background; the notification\'s Stop action stops it, and opening the app starts it again. A running process is not the same as a ready session, and loopback is reachability, not authentication.</string>
    <string name="action_read_contract">How it works</string>

