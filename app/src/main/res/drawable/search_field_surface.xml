<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher app search field: a filled, bordered rounded rect so the field is
     visible as a control in both themes instead of a bare text line. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/surface_elevated" />
    <corners android:radius="16dp" />
    <stroke android:width="1dp" android:color="@color/border" />
</shape>
