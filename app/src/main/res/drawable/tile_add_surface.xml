<?xml version="1.0" encoding="utf-8"?>
<!-- The "Add app" tile surface. It is the one tile that is an action rather
     than an app, so it reads differently: a dashed outline in the accent colour
     instead of a solid card, matching the dashed add tile in the launcher
     reference. The tile still carries a text label, so the difference is never
     carried by the stroke alone. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tile_surface_pressed" />
            <corners android:radius="18dp" />
            <stroke android:width="2dp" android:color="@color/primary"
                android:dashWidth="8dp" android:dashGap="6dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tile_surface" />
            <corners android:radius="18dp" />
            <stroke android:width="2dp" android:color="@color/primary"
                android:dashWidth="8dp" android:dashGap="6dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/tile_surface" />
            <corners android:radius="18dp" />
            <stroke android:width="1.5dp" android:color="@color/tile_add_border"
                android:dashWidth="8dp" android:dashGap="6dp" />
        </shape>
    </item>
</selector>
