<?xml version="1.0" encoding="utf-8"?>
<!-- Filled positive action. Pressed and focused states stay distinguishable
     by shape change (fill brightens, focus adds a primary stroke), not color
     alone on identical fills. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/button_primary_pressed_background" />
            <corners android:radius="@dimen/nusadesk_dialog_button_corner" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/button_primary_pressed_background" />
            <corners android:radius="@dimen/nusadesk_dialog_button_corner" />
            <stroke android:width="1dp" android:color="@color/primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/button_primary_background" />
            <corners android:radius="@dimen/nusadesk_dialog_button_corner" />
        </shape>
    </item>
</selector>
