<?xml version="1.0" encoding="utf-8"?>
<!-- Filled field surface for dialog inputs; the border switches to the
     primary token while the field holds focus. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_subtle" />
            <corners android:radius="@dimen/nusadesk_dialog_input_corner" />
            <stroke android:width="1dp" android:color="@color/primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_subtle" />
            <corners android:radius="@dimen/nusadesk_dialog_input_corner" />
            <stroke android:width="1dp" android:color="@color/border" />
        </shape>
    </item>
</selector>
