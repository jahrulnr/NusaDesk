<?xml version="1.0" encoding="utf-8"?>
<!-- Terminal tile icon: a console window with the ">_" prompt the old font
     glyph stood in for. A bundled vector, not a font glyph: a glyph's shape
     depends on the OEM system font and can degrade to a missing-glyph square,
     while a packaged vector renders the same on every device. Decorative: the
     tile root carries the accessible description. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#00000000"
        android:pathData="M4,5h16v14H4z"
        android:strokeColor="@color/primary"
        android:strokeLineJoin="round"
        android:strokeWidth="2" />
    <path
        android:fillColor="#00000000"
        android:pathData="M8,10.5l3,3l-3,3M12.5,16h4"
        android:strokeColor="@color/primary"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="2" />
</vector>
