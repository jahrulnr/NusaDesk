<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher backdrop: a subtle two-stop vertical wash. Both stops resolve per
     theme, so text contrast is unaffected in either theme. The interlocking line
     texture is drawn on top of this by LinePatternDrawable, which is why there is
     no glow or decoration baked into this drawable. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="@color/launcher_backdrop_bottom"
                android:startColor="@color/launcher_backdrop_top"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
