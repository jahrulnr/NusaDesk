<?xml version="1.0" encoding="utf-8"?>
<!-- Tappable list row (sheet options): transparent at rest, filled while
     pressed, and a visible border on keyboard focus so state is not color-only. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_subtle" />
            <corners android:radius="@dimen/nusadesk_dialog_input_corner" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_subtle" />
            <corners android:radius="@dimen/nusadesk_dialog_input_corner" />
            <stroke android:width="1dp" android:color="@color/primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="@dimen/nusadesk_dialog_input_corner" />
        </shape>
    </item>
</selector>
