<?xml version="1.0" encoding="utf-8"?>
<!-- Add / edit launcher app form. One form serves both kinds of user-defined
     launcher entry: a local web app (name, optional image, guest port) and a
     terminal-command app (name, optional image, one guest command). The shared
     fields come first (name, image), then the Type dropdown, then the one field
     that choice swaps in. The dropdown is only offered while adding — a saved
     app's kind never changes — so the whole label + Spinner field is hidden
     when an existing app is bound. Inflated into AppFormView. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/content_padding"
        android:paddingTop="20dp"
        android:paddingEnd="@dimen/content_padding"
        android:paddingBottom="@dimen/desktop_bottom_padding">

        <TextView
            android:id="@+id/app_form_heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/ink"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- The Type field is a label + Spinner pair: "Type" is a standalone
             accessible TextView tied to the control through labelFor, and
             AppFormView hides both together for an existing app, so editing
             never exposes the kind switch. -->

        <!-- Name -->
        <TextView
            style="@style/Widget.LinuxWrapper.FieldLabel"
            android:layout_marginTop="@dimen/form_field_gap"
            android:text="@string/webapp_field_name" />

        <EditText
            android:id="@+id/app_name_input"
            style="@style/Widget.LinuxWrapper.FieldInput"
            android:hint="@string/webapp_field_name_hint"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:maxLength="64" />

        <TextView
            android:id="@+id/app_name_error"
            style="@style/Widget.LinuxWrapper.FieldError"
            android:visibility="gone" />

        <!-- Image (optional) -->
        <TextView
            style="@style/Widget.LinuxWrapper.FieldLabel"
            android:layout_marginTop="@dimen/form_field_gap"
            android:text="@string/webapp_field_image" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="@dimen/webapp_form_image_size"
                android:layout_height="@dimen/webapp_form_image_size"
                android:background="@drawable/tile_icon_surface">

                <ImageView
                    android:id="@+id/app_image_preview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/webapp_image_preview_desc"
                    android:padding="6dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_image_placeholder" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <Button
                    android:id="@+id/app_image_choose"
                    style="@style/Widget.LinuxWrapper.FieldButton"
                    android:text="@string/webapp_image_choose" />

                <Button
                    android:id="@+id/app_image_remove"
                    style="@style/Widget.LinuxWrapper.FieldButton"
                    android:layout_marginTop="8dp"
                    android:text="@string/webapp_image_remove"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/app_image_error"
            style="@style/Widget.LinuxWrapper.FieldError"
            android:visibility="gone" />

        <!-- Type: a compact dropdown (web app / terminal command), sharing the
             NusaDesk dialog Spinner widget and its row layouts so the closed
             state and popup rows follow the same surfaces and typography as
             the capability dialogs. Only offered while adding, so a saved app's
             kind can never change. Sits after name and image because both kinds
             share them, and the two field groups below it are what the choice
             swaps. The label is a standalone accessible TextView tied to the
             Spinner through labelFor; hiding the field for an existing app
             removes label and control together. -->
        <TextView
            android:id="@+id/app_form_type_label"
            style="@style/Widget.LinuxWrapper.FieldLabel"
            android:layout_marginTop="@dimen/form_field_gap"
            android:labelFor="@id/app_kind_spinner"
            android:text="@string/app_form_type_label" />

        <!-- The Spinner body itself: same widget resource as the capability
             dialogs; the item rows are wired in AppFormView. -->
        <include
            android:id="@+id/app_kind_spinner"
            layout="@layout/nusadesk_dialog_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/app_form_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="2dp"
            android:text="@string/webapp_form_body"
            android:textColor="@color/ink_secondary"
            android:textSize="14sp" />

        <!-- Web app kind: the guest port its server listens on. -->
        <LinearLayout
            android:id="@+id/app_port_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Widget.LinuxWrapper.FieldLabel"
                android:layout_marginTop="@dimen/form_field_gap"
                android:text="@string/webapp_field_port" />

            <EditText
                android:id="@+id/app_port_input"
                style="@style/Widget.LinuxWrapper.FieldInput"
                android:hint="@string/webapp_field_port_hint"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="5"
                android:maxLines="1" />

            <TextView
                android:id="@+id/app_port_error"
                style="@style/Widget.LinuxWrapper.FieldError"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="2dp"
                android:text="@string/webapp_port_note"
                android:textColor="@color/ink_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Terminal-command kind: one guest command line, nothing else. The
             host never executes it, so there is deliberately no shell, cwd, or
             environment field. -->
        <LinearLayout
            android:id="@+id/app_command_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/Widget.LinuxWrapper.FieldLabel"
                android:layout_marginTop="@dimen/form_field_gap"
                android:text="@string/terminal_field_command" />

            <EditText
                android:id="@+id/app_command_input"
                style="@style/Widget.LinuxWrapper.FieldInput"
                android:hint="@string/terminal_field_command_hint"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLength="512"
                android:maxLines="1" />

            <TextView
                android:id="@+id/app_command_error"
                style="@style/Widget.LinuxWrapper.FieldError"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="2dp"
                android:text="@string/terminal_command_note"
                android:textColor="@color/ink_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Form-level failure: only for reasons that belong to no single field. -->
        <TextView
            android:id="@+id/app_form_error"
            style="@style/Widget.LinuxWrapper.FieldError"
            android:layout_marginTop="@dimen/form_field_gap"
            android:visibility="gone" />

        <Button
            android:id="@+id/app_save"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/section_gap"
            android:background="@drawable/button_primary"
            android:fontFamily="sans"
            android:minHeight="@dimen/touch_target"
            android:text="@string/webapp_save"
            android:textAllCaps="false"
            android:textColor="@color/button_primary_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/app_delete"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="12dp"
            android:background="@drawable/button_secondary"
            android:fontFamily="sans"
            android:minHeight="@dimen/touch_target"
            android:text="@string/webapp_delete"
            android:textAllCaps="false"
            android:textColor="@color/ink"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>
</merge>
