<?xml version="1.0" encoding="utf-8"?>
<!-- Compact sub-page header shared by every System page: a back affordance
     and the page title, matching the Android-Settings sub-page shape. The
     owning page view sets the title text and wires the back listener. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageButton
        android:id="@+id/system_page_back"
        android:layout_width="@dimen/touch_target"
        android:layout_height="@dimen/touch_target"
        android:layout_marginStart="-12dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/system_back_desc"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_back" />

    <TextView
        android:id="@+id/system_page_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/ink"
        android:textSize="18sp"
        android:textStyle="bold" />
</LinearLayout>
