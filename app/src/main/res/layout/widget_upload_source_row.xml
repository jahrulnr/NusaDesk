<?xml version="1.0" encoding="utf-8"?>
<!-- One file-source row in the upload source chooser (ADR-0059): the source's
     mark and its plain name. No scheme and no path appear here — the built-in
     picker states the real path itself once it is open, and the platform
     picker never needs one. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/nusadesk_dialog_item"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="16dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/upload_source_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/upload_source_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:textColor="@color/ink"
        android:textSize="16sp" />
</LinearLayout>
