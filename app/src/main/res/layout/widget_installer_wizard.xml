<?xml version="1.0" encoding="utf-8"?>
<!-- Ubuntu-live-installer setup surface. Inflated into InstallerWizardView
     (a vertical LinearLayout). The terminal log viewport is an append-only,
     monospace, dark panel that preserves install history while a compact
     progress bar and one thumb-reachable action sit below it. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Terminal log viewport. Bounded height so it never grows unbounded;
         scrolls internally to keep the latest line visible. -->
    <ScrollView
        android:id="@+id/wizard_log_scroll"
        android:layout_width="match_parent"
        android:layout_height="@dimen/wizard_log_height"
        android:layout_marginTop="12dp"
        android:background="@drawable/installer_terminal_surface"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <TextView
            android:id="@+id/wizard_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:lineSpacingExtra="1dp"
            android:padding="12dp"
            android:textColor="@color/terminal_ink"
            android:textColorLink="@color/primary"
            android:textIsSelectable="false"
            android:textSize="@dimen/wizard_log_text_size" />
    </ScrollView>

    <!-- Current progress bar. Determinate for download, indeterminate for
         verify/extract, hidden otherwise. -->
    <ProgressBar
        android:id="@+id/wizard_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:layout_marginTop="12dp"
        android:max="100"
        android:progressDrawable="@drawable/progress_horizontal"
        android:visibility="gone" />

    <!-- Current status detail line. Shows the live snapshot detail (download
         percent, verify/extract status) below the progress bar. -->
    <TextView
        android:id="@+id/wizard_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="monospace"
        android:lineSpacingExtra="1dp"
        android:textColor="@color/terminal_ink_secondary"
        android:textSize="@dimen/wizard_log_text_size"
        android:visibility="gone" />


    <!-- Optional toolkits (ADR-0057): two independent opt-ins as plain rows
         on the setup surface itself — no nested card — offered only while the
         action is a pending user choice. Each row is clickable; the checkbox
         stays the announced control. -->
    <LinearLayout
        android:id="@+id/wizard_extras"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@android:color/transparent"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:letterSpacing="0.08"
            android:text="@string/wizard_extras_title"
            android:textColor="@color/ink_muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- One shared hint keeps the card compact enough that the primary
             action stays visible above the fold; the rows are checkbox-only. -->
        <TextView
            android:id="@+id/wizard_extras_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/wizard_extras_hint"
            android:textColor="@color/ink_secondary"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/wizard_extra_usb_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <CheckBox
                android:id="@+id/wizard_extra_usb"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:minHeight="@dimen/touch_target"
                android:text="@string/wizard_extra_usb_label"
                android:textColor="@color/ink"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/wizard_extra_termux_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <CheckBox
                android:id="@+id/wizard_extra_termux"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_target"
                android:text="@string/wizard_extra_termux_label"
                android:textColor="@color/ink"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- One thumb-reachable full-width primary action. -->
    <Button
        android:id="@+id/wizard_action"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:layout_marginTop="14dp"
        android:background="@drawable/button_primary"
        android:fontFamily="sans"
        android:minHeight="@dimen/touch_target"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:text="@string/action_begin_install"
        android:textAllCaps="false"
        android:textColor="@color/button_primary_text"
        android:textSize="14sp"
        android:textStyle="bold" />

</merge>


