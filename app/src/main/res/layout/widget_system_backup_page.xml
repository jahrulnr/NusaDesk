<?xml version="1.0" encoding="utf-8"?>
<!-- System > Settings > Backup & restore page: three export modes, the
     CUSTOM folder allowlist, the SAF export/import actions, and a typed
     status surface. Inflated into SystemBackupPageView; the view owns no
     policy — selection and typed failures cross as domain/application values. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/content_padding"
        android:paddingTop="4dp"
        android:paddingEnd="@dimen/content_padding"
        android:paddingBottom="@dimen/desktop_bottom_padding">

        <include layout="@layout/widget_system_page_header" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/system_backup_body"
            android:textColor="@color/ink_secondary"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/card_surface"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                style="@style/Widget.LinuxWrapper.Eyebrow"
                android:text="@string/system_backup_export_label" />

            <RadioGroup
                android:id="@+id/system_backup_mode_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:checkedButton="@+id/system_backup_mode_full"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/system_backup_mode_full"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_target"
                    android:text="@string/system_backup_mode_full"
                    android:textColor="@color/ink"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/system_backup_mode_home"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_target"
                    android:text="@string/system_backup_mode_home"
                    android:textColor="@color/ink"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/system_backup_mode_custom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_target"
                    android:text="@string/system_backup_mode_custom"
                    android:textColor="@color/ink"
                    android:textSize="14sp" />
            </RadioGroup>

            <TextView
                android:id="@+id/system_backup_mode_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/system_backup_mode_full_detail"
                android:textColor="@color/ink_secondary"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/system_backup_custom_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone" />

            <Button
                android:id="@+id/system_backup_export_action"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_target"
                android:layout_marginTop="12dp"
                android:background="@drawable/button_secondary"
                android:fontFamily="sans"
                android:minHeight="@dimen/touch_target"
                android:text="@string/system_backup_export_action"
                android:textAllCaps="false"
                android:textColor="@color/primary_dark"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_surface"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                style="@style/Widget.LinuxWrapper.Eyebrow"
                android:text="@string/system_backup_restore_label" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/system_backup_restore_detail"
                android:textColor="@color/ink_secondary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/system_backup_import_action"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_target"
                android:layout_marginTop="12dp"
                android:background="@drawable/button_secondary"
                android:fontFamily="sans"
                android:minHeight="@dimen/touch_target"
                android:text="@string/system_backup_import_action"
                android:textAllCaps="false"
                android:textColor="@color/primary_dark"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_surface"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                style="@style/Widget.LinuxWrapper.Eyebrow"
                android:text="@string/system_backup_status_label" />

            <TextView
                android:id="@+id/system_backup_last_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/system_backup_last_none"
                android:textColor="@color/ink"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/system_backup_last_run_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/ink_secondary"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/system_backup_progress_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/ink_secondary"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/system_backup_result_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/ink_secondary"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/info_surface"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/system_backup_help_title"
                android:textColor="@color/ink"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/system_backup_help_body"
                android:textColor="@color/ink_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</merge>
