<?xml version="1.0" encoding="utf-8"?>
<!-- Linux system screen: install state, session details, and the contract. -->
<!-- It reports state; it never offers a session start/stop control, because -->
<!-- Linux starts from an app launch and is stopped from the platform's own -->
<!-- foreground-service notification (ADR-0013). Inflated into SystemScreenView. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/content_padding"
        android:paddingTop="16dp"
        android:paddingEnd="@dimen/content_padding"
        android:paddingBottom="@dimen/desktop_bottom_padding">

        <TextView
            style="@style/Widget.LinuxWrapper.Eyebrow"
            android:text="@string/system_eyebrow" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/system_title"
            android:textColor="@color/ink"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="2dp"
            android:text="@string/system_body"
            android:textColor="@color/ink_secondary"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_gap"
            android:background="@drawable/card_surface"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/system_state_label"
                    android:textColor="@color/ink_secondary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <gh.nusashell.nusadesk.presentation.widget.StateBadgeView
                    android:id="@+id/system_state_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="10dp"
                    android:paddingTop="7dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="7dp"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/system_state_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/ink_secondary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/system_state_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/ink_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_gap"
            android:background="@drawable/card_surface"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/system_session_label"
                    android:textColor="@color/ink_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/system_session_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:textColor="@color/ink"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/system_service_label"
                    android:textColor="@color/ink_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/system_service_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:textColor="@color/ink"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/system_webapps_label"
                    android:textColor="@color/ink_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/system_webapps_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:textColor="@color/ink"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Workspace: a user-picked folder bound into the guest at ~/nusadesk. -->
        <!-- The card states why Android 11+ needs all-files access, and says so -->
        <!-- honestly when the platform cannot host a workspace at all (ADR-0023). -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_gap"
            android:background="@drawable/card_surface"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                style="@style/Widget.LinuxWrapper.Eyebrow"
                android:text="@string/system_workspace_label" />

            <TextView
                android:id="@+id/system_workspace_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/system_workspace_value_none"
                android:textColor="@color/ink"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/system_workspace_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/ink_secondary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/system_workspace_action"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="14dp"
                android:background="@drawable/button_secondary"
                android:fontFamily="sans"
                android:minHeight="@dimen/touch_target"
                android:textAllCaps="false"
                android:textColor="@color/primary_dark"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- App permissions: the Android permission switches for this app live in
             the platform's own App Info page. NusaDesk never prompts for these
             here — the shortcut only opens that page (ADR-0023 leaves storage
             access to the workspace card; everything else is managed in
             Settings). -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_gap"
            android:background="@drawable/card_surface"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                style="@style/Widget.LinuxWrapper.Eyebrow"
                android:text="@string/system_permissions_label" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="2dp"
                android:text="@string/system_permissions_detail"
                android:textColor="@color/ink_secondary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/system_permissions_action"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="14dp"
                android:background="@drawable/button_secondary"
                android:fontFamily="sans"
                android:minHeight="@dimen/touch_target"
                android:text="@string/system_permissions_action"
                android:textAllCaps="false"
                android:textColor="@color/primary_dark"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_gap"
            android:background="@drawable/card_surface"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                style="@style/Widget.LinuxWrapper.Eyebrow"
                android:text="@string/system_details_eyebrow" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/system_detail_endpoint"
                    android:textColor="@color/ink_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/system_endpoint_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:textColor="@color/ink"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/system_detail_app"
                    android:textColor="@color/ink_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/system_profile_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:textColor="@color/ink"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/system_detail_version"
                    android:textColor="@color/ink_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/system_version_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:textColor="@color/ink"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/system_how_button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/section_gap"
            android:background="@drawable/button_secondary"
            android:fontFamily="sans"
            android:minHeight="@dimen/touch_target"
            android:text="@string/action_read_contract"
            android:textAllCaps="false"
            android:textColor="@color/primary_dark"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</merge>
