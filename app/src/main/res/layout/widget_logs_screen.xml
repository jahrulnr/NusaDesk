<?xml version="1.0" encoding="utf-8"?>
<!-- Compact Logs surface: a flat, readable catalog plus the live xterm viewer. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ScrollView
            android:id="@+id/logs_list_pane"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/content_padding"
                android:paddingTop="12dp"
                android:paddingEnd="@dimen/content_padding"
                android:paddingBottom="@dimen/desktop_bottom_padding">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/logs_title"
                    android:textColor="@color/ink"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/logs_body"
                    android:textColor="@color/ink_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/logs_boot_header"
                    style="@style/Widget.LinuxWrapper.Eyebrow"
                    android:layout_marginTop="16dp"
                    android:text="@string/logs_section_boot" />

                <LinearLayout
                    android:id="@+id/logs_boot_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/logs_system_header"
                    style="@style/Widget.LinuxWrapper.Eyebrow"
                    android:layout_marginTop="14dp"
                    android:text="@string/logs_section_system" />

                <LinearLayout
                    android:id="@+id/logs_system_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:id="@+id/logs_empty_pane"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/content_padding"
            android:visibility="gone">

            <TextView
                android:id="@+id/logs_empty_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/ink"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/logs_empty_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textColor="@color/ink_secondary"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/logs_viewer_pane"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/terminal_surface"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/terminal_chrome_surface"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/logs_viewer_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:textColor="@color/terminal_ink"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/logs_viewer_path"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="start"
                        android:singleLine="true"
                        android:textColor="@color/terminal_ink_secondary"
                        android:textSize="11sp"
                        android:typeface="monospace" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/logs_back"
                    android:layout_width="@dimen/touch_target"
                    android:layout_height="@dimen/touch_target"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/button_secondary_compact"
                    android:contentDescription="@string/logs_back_desc"
                    android:padding="12dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_close" />
            </LinearLayout>

            <gh.nusashell.nusadesk.presentation.widget.TerminalBridgeView
                android:id="@+id/logs_bridge"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@color/terminal_surface" />
        </LinearLayout>
    </FrameLayout>
</merge>
