<?xml version="1.0" encoding="utf-8"?>
<!-- System > Settings page: the control rows that used to sit on the single
     System scroll — workspace, battery optimization, boot start, and the app
     settings shortcut. Inflated into SystemSettingsPageView. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/content_padding"
        android:paddingTop="4dp"
        android:paddingEnd="@dimen/content_padding"
        android:paddingBottom="@dimen/desktop_bottom_padding">

        <include layout="@layout/widget_system_page_header" />

        <!-- The session card sits first: the Linux session is the context
             every other control on this page applies to. It reports the live
             runtime state and owns the one Restart Linux action (ADR-0085). -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_surface"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                style="@style/Widget.LinuxWrapper.Eyebrow"
                android:text="@string/system_session_label" />

            <TextView
                android:id="@+id/system_session_card_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/session_badge_stopped"
                android:textColor="@color/ink"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/system_session_card_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/system_session_detail"
                android:textColor="@color/ink_secondary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/system_session_card_action"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_target"
                android:layout_marginTop="10dp"
                android:background="@drawable/button_secondary"
                android:fontFamily="sans"
                android:minHeight="@dimen/touch_target"
                android:text="@string/system_session_restart"
                android:textAllCaps="false"
                android:textColor="@color/primary_dark"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_surface"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                style="@style/Widget.LinuxWrapper.Eyebrow"
                android:text="@string/system_workspace_label" />

            <TextView
                android:id="@+id/system_workspace_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/system_workspace_value_none"
                android:textColor="@color/ink"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/system_workspace_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/system_workspace_detail_none"
                android:textColor="@color/ink_secondary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/system_workspace_action"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_target"
                android:layout_marginTop="10dp"
                android:background="@drawable/button_secondary"
                android:fontFamily="sans"
                android:minHeight="@dimen/touch_target"
                android:textAllCaps="false"
                android:textColor="@color/primary_dark"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_surface"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                style="@style/Widget.LinuxWrapper.Eyebrow"
                android:text="@string/system_battery_label" />

            <TextView
                android:id="@+id/system_battery_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/system_battery_value_not_exempt"
                android:textColor="@color/ink"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/system_battery_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/system_battery_detail_not_exempt"
                android:textColor="@color/ink_secondary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/system_battery_action"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_target"
                android:layout_marginTop="10dp"
                android:background="@drawable/button_secondary"
                android:fontFamily="sans"
                android:minHeight="@dimen/touch_target"
                android:text="@string/system_battery_action_request"
                android:textAllCaps="false"
                android:textColor="@color/primary_dark"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_surface"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                style="@style/Widget.LinuxWrapper.Eyebrow"
                android:text="@string/system_boot_label" />

            <TextView
                android:id="@+id/system_boot_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/system_boot_value_disabled"
                android:textColor="@color/ink"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/system_boot_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/system_boot_detail_disabled"
                android:textColor="@color/ink_secondary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/system_boot_action"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_target"
                android:layout_marginTop="10dp"
                android:background="@drawable/button_secondary"
                android:fontFamily="sans"
                android:minHeight="@dimen/touch_target"
                android:text="@string/system_boot_action_enable"
                android:textAllCaps="false"
                android:textColor="@color/primary_dark"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_surface"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                style="@style/Widget.LinuxWrapper.Eyebrow"
                android:text="@string/system_permissions_label" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/system_permissions_detail"
                android:textColor="@color/ink_secondary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/system_permissions_action"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_target"
                android:layout_marginTop="10dp"
                android:background="@drawable/button_secondary"
                android:fontFamily="sans"
                android:minHeight="@dimen/touch_target"
                android:text="@string/system_permissions_action"
                android:textAllCaps="false"
                android:textColor="@color/primary_dark"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</merge>
