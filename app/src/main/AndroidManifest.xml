<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Runtime foundation: the curated payload download/verify pipeline, the
         guest SSH client on loopback, and the web-app favicon fetch. Normal
         permission, no runtime grant. No LAN exposure is implied — every
         server this app talks to or starts is loopback or an allowlisted
         HTTPS catalog. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!--
        Required to read the active network's DNS servers
        (ConnectivityManager.getActiveNetwork/getLinkProperties) so the guest
        /etc/resolv.conf can be built from the network Android actually routes
        on (ADR-0019). Normal, non-dangerous permission: no runtime grant,
        no network I/O of its own, and no broad storage/LAN/battery scope.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!--
        Assisted in-app update (ADR-0039). The verified release APK is staged
        through the platform PackageInstaller, which requires this permission
        for a non-store source; the one-time per-app "install unknown apps"
        toggle is enabled by the user from the install popup's own step, and
        the platform still shows its confirmation dialog on every install —
        nothing is applied silently. The signing chain stays the security
        boundary: the platform refuses an APK not signed by this app's key.
        Distribution note: restricted on Google Play; acceptable for the
        project's signed-GitHub-release/F-Droid channel.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!--
        Opt-in "Start Linux at boot" (ADR-0037). Normal install-time
        permission — no runtime grant — that lets the system deliver the
        boot-completed broadcast to BootStartReceiver. The setting defaults
        to OFF on the Linux system screen, so a stock install never wakes at
        boot; when the user opts in, the receiver re-checks the persisted
        install state and reuses the same idempotent ensure-running boundary
        an Activity foreground event calls. The receiver also listens to
        MY_PACKAGE_REPLACED (an app update kills the runtime process; this
        restores it after replacement) but never LOCKED_BOOT_COMPLETED:
        credential-encrypted storage is unavailable before the first unlock,
        and every persisted signal the boot gate reads lives there. Jobs,
        alarms, and sticky-restart paths remain forbidden.
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!--
        Workspace folder (ADR-0023). A user-picked folder (for example
        Documents/nusadesk) is bound into the guest at ~/nusadesk.

        PRoot binds a real host path, and on Android 11+ only all-files access
        lets this app open a shared-storage path directly: a Storage Access
        Framework grant yields a content URI, which cannot be bound. The
        permission is therefore tied to an explicit user action — the workspace
        action in the Linux system screen explains why it is needed and sends
        the user to Settings — and it is never assumed: with no grant, or with a
        folder that fails a probe write, the guest simply starts without a
        workspace. Android 10 cannot grant it at all: there the workspace is the
        app's own external folder, which needs no permission, and the screen says
        exactly that instead of offering a folder that could not work.

        Distribution note: this permission exists from API 30. The project
        currently ships only the signed GitHub release APK; publishing on Google
        Play would additionally require the All files access declaration form
        and an approved use case.
    -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!--
        Android 10 (API 29) uses the platform's own legacy storage model for the
        workspace: requestLegacyExternalStorage restores the pre-scoped model on
        API 29 devices (Android 11+ ignores it for this targetSdk, so it changes
        nothing there), and the two runtime permissions are the classic gate for
        raw shared-storage paths on that release. Measured on the S7 Edge
        (API 29, 2026-09-21): with the flag alone the app still sees list=null /
        canRead=false for /sdcard; with the flag and both grants it gets
        list=171 / canRead=true / canWrite=true and can create a file in
        /sdcard. Both are bounded to API 29, and nothing here is requested on
        Android 11+, where the all-files grant above is the door. ADR-0047.
    -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!--
        ==========================================================================
        Android capability bridge — permissions declared ahead of implementation
        ==========================================================================

        A non-root PRoot guest cannot call Android platform APIs: SELinux denies
        /dev/binder, the app has no Android framework in the guest, and a PRoot
        "root" is a user-namespace root, not a host one. Any device capability
        (camera, location, microphone, sensors, Bluetooth) therefore has to be
        fetched by this app and handed to the guest over an owned channel.

        These permissions are the reviewed set for the shipped and future
        capability paths. The live media slice checks CAMERA and RECORD_AUDIO,
        starts its dedicated camera|microphone foreground service only after
        the guest requests `media.start`, and never prompts from the bridge.
        Other declared permissions remain explicit future scope and must not be
        treated as implemented merely because they appear in the manifest.

        Rules that still apply:
        - Nothing may request a runtime grant at launch. A grant is only ever
          asked for from an explicit user action that explains the capability.
        - Special access (overlay, usage stats, battery exemption, all-files)
          is never assumed: the capability reports itself unavailable until the
          user enables it in Settings.
        - No LAN binding is declared or implied. Loopback is the only channel.
        - Every permission here must either be used by a shipped capability or
          be removed again before a stable release: an unused sensitive
          permission still shows up in the installer's permission list.

        Hosting decision: the control bridge remains owned by the existing
        user-visible Linux session, while live camera/microphone capture uses
        a separate unexported foreground service only for the duration of an
        explicit `media.start` request. The matching type permissions and
        service declaration are enforced by the media implementation.
    -->

    <!-- Camera capability (live-only media stream; no capture artifact). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Microphone capability. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Location capability. Coarse is declared alongside fine because the
         platform can grant either level. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Lifts the platform's default 200 Hz sensor sampling cap, so a guest
         automation script can read accelerometer/gyroscope at full rate.
         Normal permission, granted at install, no prompt. Lint flags it as
         rarely needed; that flag is overridden deliberately because the whole
         point of this block is to expose an API surface the user opts into. -->
    <uses-permission
        android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS"
        tools:ignore="HighSamplingRate" />
    <!-- Step/motion detection for guest automation. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <!-- Bridge status notifications. The runtime's own foreground-service
         notification stays exempt from this; the permission exists for a
         capability that needs to tell the user something on its own. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Bluetooth capability.
         API 31+ uses the runtime-granted SCAN/CONNECT pair; scan results are
         never used to derive location, which is what the flag asserts. The
         flag attribute itself only exists from API 31, so it carries a
         targetApi marker for the API 29 floor build. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <!-- API 30 and below instead use the install-granted legacy pair. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <!-- Foreground-service types the capabilities will declare at runtime. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- Bounded data-processing work for a user-invoked automation run. The
         AGENTS.md rule still stands: this type must never be used as an
         indefinite server process. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!--
        User-invoked automation surface.

        Some users want to drive Android from inside their Linux workspace:
        a guest script that reads location, watches motion, reacts to a call,
        or posts an overlay. The product's job is to expose the API and hold
        the grant; whether a capability is ever exercised is the user's
        decision, made at the moment they run something that needs it.

        Nothing here is requested at launch or in the background. Each grant is
        asked for from an explicit user action that explains the capability,
        and a user who never touches automation is never prompted. A capability
        whose grant is missing reports itself unavailable to the guest instead
        of failing silently.

        Distribution note: several of these are Google Play "restricted" or
        "special access" permissions (background location, battery-exemption,
        call log, SMS, all-packages, overlay, usage stats). That is acceptable
        for this project's declared channel — signed GitHub releases and
        F-Droid — but a Play submission would need the matching declaration
        forms and approved use cases first. See docs/limitations.md.
    -->

    <!-- Background location. Restricted on API 30+: the user must first grant
         foreground location, then choose "Allow all the time" in Settings;
         there is no single dialog that grants it. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- Telephony and messaging inputs for automation triggers. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- Calendar write access for the bounded calendar.insert/update/delete
         methods. The bridge never opens a consent UI: the grant is the user's
         own decision from Android App Info, and a missing grant answers a
         typed calendar-permission-required / calendar-permission-denied
         instead of prompting. -->
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <!-- Keep the CPU alive during a user-invoked automation run. Normal
         permission, granted at install; the runtime still releases it. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Ask the user to exempt the app from battery optimization. Special
         access via Settings, never assumed. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Draw over other apps, for a guest-driven overlay. Special access via
         Settings, never assumed. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Per-app usage statistics, for automation that reacts to what the user
         is doing. Special access via Settings, never assumed. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Enumerate launchable apps so a guest script can start one.
         Lint prefers a narrower <queries> block; that is the right answer once
         the concrete automation use cases are known, because it needs no
         blanket grant and no store declaration. The blanket form is kept for
         now so a guest script can resolve any package the user names at
         runtime, which is the point of exposing the surface. Install-time
         permission: the user cannot revoke it per-app, so revisit this before a
         stable release. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!--
        Termux:API parity surface (tasks/termux-parity-matrix.md). Every entry
        here exists because a `termux-*` client command needs it and the user
        asked for the full Android capability surface to be reachable from the
        guest. The pattern is unchanged from ADR-0030: one method = one
        permission set, checked per call, a missing grant is a typed result,
        and special access goes through Settings instead of a fake dialog.
    -->
    <!-- termux-vibrate: normal permission, granted at install. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- termux-sms-send: runtime grant, asked on first use. -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <!-- termux-telephony-call: runtime grant, asked on first use. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- termux-wallpaper: normal permission, granted at install. -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <!-- termux-infrared-*: normal permission. The S10e has no IR emitter, so
         the commands answer typed-absent there; the permission keeps a device
         with the hardware working without a code change. -->
    <uses-permission android:name="android.permission.TRANSMIT_IR" />
    <!-- termux-nfc: normal permission; the reader-mode flow needs the app in
         the foreground. -->
    <uses-permission android:name="android.permission.NFC" />
    <!-- termux-brightness: special access (Settings.System write), opened
         through the platform Settings screen, never assumed. -->
    <uses-permission
        android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- termux-fingerprint: normal permission plus a visible BiometricPrompt. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- termux-wifi-*: connection/scan reads need the location grant the app
         already holds; these are the wifi state reads and the API 33+ nearby
         devices gate. Toggling wifi is refused by the platform for third-party
         apps on API 29+ and the command reports that instead of pretending. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" />
    <!-- termux-volume / termux-audio-info: normal permission. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- termux-media-player: a foreground service with the media-playback type
         keeps audio alive while the guest session owns playback. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- termux-download: lets DownloadManager post its own progress without a
         second notification path. -->
    <uses-permission android:name="android.permission.DOWNLOAD_WITHOUT_NOTIFICATION" />
    <!-- No READ_MEDIA_*: nothing queries MediaStore image/video/audio —
         media.scan feeds resolved guest paths to MediaScannerConnection and
         storage reads go through MANAGE_EXTERNAL_STORAGE + SAF. -->

    <!--
        Not declared here, because they are not plain permissions and each needs
        its own accepted decision:
        - Accessibility service: declared as a <service> with
          BIND_ACCESSIBILITY_SERVICE, and it can read all on-screen content
          including credentials. That is a different class of capability, not
          an API surface to opt into. No Termux client command needs it.
        - SMS receive trigger: needs a broadcast receiver component, which
          would add a background wake-up path beyond the single opt-in boot
          receiver the amended autostart contract allows (ADR-0037). READ_SMS
          above covers on-demand reads only.
        - WRITE_EXTERNAL_STORAGE: not needed on API 30+ (all-files access covers
          it); on API 29 it is declared above with maxSdkVersion="29" because the
          legacy workspace model needs it (ADR-0047).
    -->

    <!--
        Declaring CAMERA/RECORD_AUDIO/ACCESS_*_LOCATION makes Google Play imply
        the matching hardware features as REQUIRED, which would hide the app
        from devices without them. The product runs a curated Linux runtime, so
        these features are optional: the bridge simply reports an unavailable
        capability instead of the app becoming uninstallable.
    -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.gyroscope" android:required="false" />

    <application
        android:name=".infrastructure.integration.LinuxWrapperApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false"
        android:requestLegacyExternalStorage="true">
        <activity
            android:name=".presentation.MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Foreground host shell for the local Linux runtime. Lifecycle host
            only: it owns the user-visible status notification and a Stop
            action, and delegates start/stop to the single registered runtime
            workload. It does not run PRoot or start arbitrary code.
            Linux starts from a user-visible launch (the Activity calls
            RuntimeHostService.ensureRunning) and keeps running while the app is
            backgrounded. The only background start path is the user's own
            opt-in "Start Linux at boot" receiver (ADR-0037), which re-checks
            the persisted install state before calling the same boundary;
            jobs, alarms, and sticky-restart resurrection remain forbidden.
            The specialUse subtype rationale and any distribution-channel
            policy review (e.g. Google Play special-use review) still need to
            be completed before a public release; see ADR-0007 and ADR-0013.
        -->
        <service
            android:name=".infrastructure.service.RuntimeHostService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="linux_runtime_host: supervises a packaged, verified guest runtime on the fixed loopback SSH endpoint for the in-app terminal; started from a user-visible launch, user-visible with a Stop action, not a background server" />
        </service>

        <!--
            Live camera + microphone foreground service (media.start/status/
            stop). Started only by a guest command through the capability
            bridge while the app is foreground-eligible (the platform's
            background-start ban is the enforcement, mapped to
            media-foreground-required). It posts a user-visible notification
            with a Stop action, serves the H.264/AAC stream on the loopback
            RTSP listener only (127.0.0.1, ephemeral port), and stops cleanly
            with the owning bridge session. No capture artifact is written;
            consumers may save manually.
        -->
        <service
            android:name=".infrastructure.service.LiveMediaService"
            android:exported="false"
            android:foregroundServiceType="camera|microphone" />

        <!--
            Foreground capability host (dialog, runtime consent, SAF pickers,
            share chooser, biometric prompt, speech recognition, NFC reader
            mode). Transparent and inert on its own: the capability bridge
            parks exactly one bounded operation and launches this Activity to
            run it, because the platform only allows those platform APIs to a
            visible app. No layout, no exported surface, never in recents.
        -->
        <activity
            android:name=".infrastructure.androidbridge.foreground.CapabilityForegroundActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!--
            Notification listener (termux-notification-list). Inert until the
            user grants notification access in Settings; the module reports
            that state as a typed permission result and never pretends to see
            notifications it cannot. BIND_NOTIFICATION_LISTENER_SERVICE is
            held by the system, so only the platform can bind it.
        -->
        <service
            android:name=".infrastructure.androidbridge.CapabilityNotificationListenerService"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!--
            Capture foreground service (termux-camera-photo,
            termux-microphone-record). Started only from the foreground host
            while the app is visible (the platform's while-in-use rule), owns
            the camera/microphone device work on one worker, and posts a
            user-visible notification. No capture artifact is written outside
            the guest path the command asked for.
        -->
        <service
            android:name=".infrastructure.service.CaptureService"
            android:exported="false"
            android:foregroundServiceType="camera|microphone" />

        <!--
            Media playback foreground service (termux-media-player). Owns one
            MediaPlayer and keeps audio alive while the guest session drives
            it, with a user-visible notification and a Stop action.
        -->
        <service
            android:name=".infrastructure.service.MediaPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!--
            Job scheduler bridge (termux-job-scheduler). The job can only run
            while the NusaDesk guest session is alive: the service re-checks the
            published runtime state and records a `session-down` outcome instead
            of pretending a background run happened. BIND_JOB_SERVICE is held by
            the system, so only the platform can start it.
        -->
        <service
            android:name=".infrastructure.androidbridge.CommsJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!--
            Opt-in boot start (ADR-0037). Enabled by the user's "Start Linux
            at boot" toggle on the Linux system screen (default OFF); without
            that stored opt-in this receiver is inert. Unexported — both
            actions are protected broadcasts only the system can send, and
            MY_PACKAGE_REPLACED is only ever delivered to the replaced
            package itself. Not directBootAware: credential-encrypted storage
            is unavailable before the first unlock, so LOCKED_BOOT_COMPLETED
            is never requested. On a trigger the receiver re-checks the
            persisted install state and calls the same idempotent
            ensure-running boundary an Activity foreground event uses; it
            never installs, downloads, or schedules anything.
        -->
        <receiver
            android:name=".infrastructure.boot.BootStartReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
